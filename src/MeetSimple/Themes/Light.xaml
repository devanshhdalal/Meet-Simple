<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Dark.xaml must define exactly the same keys. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF4FF" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F6FA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#DFE3EC" />
    <SolidColorBrush x:Key="TextBrush" Color="#111827" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="ErrorFillBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="TrackBrush" Color="#E5E8F0" />
    <SolidColorBrush x:Key="HoverTintBrush" Color="#111827" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#9CA3AF" />
    <!-- Sidebar and window chrome sit on the coloured space backdrop -->
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#1E2142" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#4A5075" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="SidebarPillBrush" Color="#80FFFFFF" />
</ResourceDictionary>
