<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Light.xaml must define exactly the same keys. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FEB" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#7AA7FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1C2A47" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0F1218" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171B24" />
    <SolidColorBrush x:Key="LineBrush" Color="#2B3140" />
    <SolidColorBrush x:Key="TextBrush" Color="#E7EAF0" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9BA3B2" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
    <SolidColorBrush x:Key="ErrorFillBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2B3140" />
    <SolidColorBrush x:Key="HoverTintBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4B5565" />
    <!-- Sidebar and window chrome sit on the coloured space backdrop -->
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#F1F2FA" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#B5B9D3" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SidebarPillBrush" Color="#1AFFFFFF" />
</ResourceDictionary>
