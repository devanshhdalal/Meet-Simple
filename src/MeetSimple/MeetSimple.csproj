<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK target gives access to Windows notifications (call recorded: Summarize / Transcribe / Save). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); its namespaces are kept out of global usings below to avoid WPF name clashes. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Meet Simple</Product>
    <AssemblyTitle>Meet Simple</AssemblyTitle>
    <RootNamespace>MeetSimple</RootNamespace>
    <AssemblyName>MeetSimple</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- English UI only — skip dozens of .NET satellite assemblies in publish. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Security and reproducibility -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <!-- Style-only analyzer hints that add noise; real warnings stay visible -->
    <NoWarn>$(NoWarn);CA1305;CA1816;CA1822;CA1862;CA1863;CA1869</NoWarn>
  </PropertyGroup>

  <!-- Release / share builds: no PDBs next to the app. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF projects leave these out of ImplicitUsings -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Inter (Regular / Medium / SemiBold / Bold) and Inter Display Bold, embedded. The OFL licence must ship with the fonts. -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL.txt" Link="Licenses\Inter-OFL.txt" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit so packages.lock.json matches both `dotnet build` and single-file `dotnet publish`
         (publish injects this otherwise and locked-mode restore fails with NU1004). -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="8.0.33" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.0" />
  </ItemGroup>

</Project>
