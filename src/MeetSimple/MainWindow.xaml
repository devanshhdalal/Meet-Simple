<Window x:Class="MeetSimple.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Meet Simple" Width="1120" Height="740" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource SpaceBackdropBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="14"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <!-- No standard title bar: the sidebar runs to the top edge and the top strip drags the window. -->
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar, drawn straight onto the coloured space backdrop ===== -->
        <Grid Grid.Column="0" Margin="10,0,0,12" TextElement.Foreground="{DynamicResource SidebarTextBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand row also acts as a drag strip for the custom chrome. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Height="40" Margin="6,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="False">
                <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Meet Simple" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </StackPanel>

            <Button Grid.Row="1" x:Name="NewButton" Style="{StaticResource SidebarButton}" Height="42"
                    Padding="10,8" Background="{DynamicResource SidebarPillBrush}" Margin="0,2,0,0" Click="OnNewClick"
                    ToolTip="Start something new">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE710;" FontSize="14" Width="22" />
                    <TextBlock Text="New transcript" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </Button>

            <!-- Pinned shortcuts, like Arc's pinned tiles -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="-3,10,-3,0">
                <Button Style="{StaticResource SidebarButton}" Height="66" Margin="3"
                        Background="{DynamicResource SidebarPillBrush}" Click="OnPinnedTranscribeClick"
                        ToolTip="Transcribe only" HorizontalContentAlignment="Center">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8A5;" FontSize="18" />
                        <TextBlock Text="Transcribe" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SidebarButton}" Height="66" Margin="3"
                        Background="{DynamicResource SidebarPillBrush}" Click="OnPinnedSummarizeClick"
                        ToolTip="Transcribe and summarize" HorizontalContentAlignment="Center">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8FD;" FontSize="18" />
                        <TextBlock Text="Summarize" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SidebarButton}" Height="66" Margin="3"
                        Background="{DynamicResource SidebarPillBrush}" Click="OnPinnedFolderClick"
                        ToolTip="Open my recordings folder" HorizontalContentAlignment="Center">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8B7;" FontSize="18" />
                        <TextBlock Text="Recordings" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Text="LIBRARY" FontSize="10.5" FontWeight="SemiBold" Margin="10,0,0,8"
                           Foreground="{DynamicResource SidebarMutedBrush}" />
                <RadioButton x:Name="NavHome" GroupName="Navigation" Style="{StaticResource SidebarNavButton}"
                             Click="OnHomeNavClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE80F;" FontSize="15" Width="22" />
                        <TextBlock Text="Home" Margin="8,0,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSettings" GroupName="Navigation" Style="{StaticResource SidebarNavButton}"
                             Margin="0,3,0,0" Click="OnSettingsClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE713;" FontSize="15" Width="22" />
                        <TextBlock Text="Settings" Margin="8,0,0,0" />
                    </StackPanel>
                </RadioButton>
                <Button Style="{StaticResource SidebarButton}" Margin="0,3,0,0" Click="OnTourClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE897;" FontSize="15" Width="22" />
                        <TextBlock Text="Quick tour" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Space switcher and light/dark toggle, like the bottom bar in Arc -->
            <Grid Grid.Row="5" Margin="4,4,0,0">
                <StackPanel x:Name="SpaceDots" Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                <Button x:Name="ThemeToggle" Style="{StaticResource SidebarButton}" HorizontalAlignment="Right"
                        Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center"
                        FontFamily="Segoe MDL2 Assets" FontSize="15" Click="OnThemeToggleClick" />
            </Grid>
        </Grid>

        <!-- ===== Window buttons + the floating content card ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,2,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimizeClick" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        ToolTip="Maximize" Click="OnMaximizeClick" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="OnCloseClick" />
            </StackPanel>

            <Border Grid.Row="1" x:Name="CardShell" Margin="6,0,12,12" CornerRadius="14"
                    Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Color="Black" Opacity="0.16" />
                </Border.Effect>
                <Grid x:Name="CardContent">
                    <ContentControl x:Name="Host" />
                    <!-- Picture of the previous screen that fades away, so a change is never abrupt -->
                    <Image x:Name="PageSnapshot" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <!-- Picture of the previous theme / space that fades away -->
        <Image x:Name="ThemeSnapshot" Grid.ColumnSpan="2" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</Window>
