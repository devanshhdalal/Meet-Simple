<UserControl x:Class="MeetSimple.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,24">
            <TextBlock Text="What would you like to do?" Style="{StaticResource DisplayTitle}" FontSize="26"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Turn meetings and recordings into text — privately, on this computer."
                       FontSize="14" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                       Margin="0,8,0,28" TextAlignment="Center" MaxWidth="480" TextWrapping="Wrap" />

            <WrapPanel HorizontalAlignment="Center">
                <Button Style="{StaticResource ChoiceCardButton}" Width="330" Height="248" Margin="10"
                        Click="OnTranscribeOnlyClick">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Top" Style="{StaticResource IconBadge}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8A5;" FontSize="19"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="Transcribe only" Style="{StaticResource DisplayTitle}"
                                   FontSize="19" Margin="0,14,0,6" />
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="Get the full text of your meeting or recording, with timestamps." />
                        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="Faster. Downloads the speech model the first time." />
                    </DockPanel>
                </Button>

                <Button Style="{StaticResource ChoiceCardButton}" Width="330" Height="248" Margin="10"
                        Click="OnSummarizeClick">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Top" Style="{StaticResource IconBadge}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8FD;" FontSize="19"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="Transcribe + summarize" Style="{StaticResource DisplayTitle}"
                                   FontSize="19" Margin="0,14,0,6" />
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="Also get a short summary with only the important points, decisions and tasks." />
                        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="Takes longer. First time: sets up a local AI (about 6 GB). We ask before downloading." />
                    </DockPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
