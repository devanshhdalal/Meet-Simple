<Window x:Class="MeetSimple.Views.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MeetSimple.Views"
        Title="Quick tour" Width="620" Height="540" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="14"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid x:Name="Root" Margin="34,28,34,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" x:Name="StepDots" Orientation="Horizontal" Margin="0,0,0,14" />
        <TextBlock Grid.Row="1" x:Name="StepCounterText" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentTextBrush}" />
        <TextBlock Grid.Row="2" x:Name="TitleText" Style="{StaticResource DisplayTitle}" FontSize="26"
                   Margin="0,6,0,10" />
        <TextBlock Grid.Row="3" x:Name="BodyText" TextWrapping="Wrap" LineHeight="22" />

        <Border Grid.Row="4" x:Name="MetersPanel" Style="{StaticResource PanelBorder}" Padding="20"
                Margin="0,18,0,0" VerticalAlignment="Top" Visibility="Collapsed"
                Background="{DynamicResource BackgroundBrush}">
            <views:LevelMetersControl x:Name="Meters" />
        </Border>

        <DockPanel Grid.Row="5" LastChildFill="False">
            <Button x:Name="SkipButton" Content="Skip tour" Style="{StaticResource LinkButton}"
                    DockPanel.Dock="Left" Click="OnSkipClick" />
            <Button x:Name="NextButton" Content="Next" Style="{StaticResource AccentButton}"
                    DockPanel.Dock="Right" Padding="26,10" Click="OnNextClick" />
            <Button x:Name="BackButton" Content="Back" Style="{StaticResource QuietButton}"
                    DockPanel.Dock="Right" Margin="0,0,10,0" Click="OnBackClick" />
        </DockPanel>
    </Grid>
</Window>
