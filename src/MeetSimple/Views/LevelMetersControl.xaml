<UserControl x:Class="MeetSimple.Views.LevelMetersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MeetSimple.Views">
    <UserControl.Resources>
        <!-- Compact device picker beside each heading -->
        <Style x:Key="DevicePicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5,34,5" />
            <Setter Property="DisplayMemberPath" Value="Name" />
            <Setter Property="ToolTip" Value="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Your microphone" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox x:Name="MicrophonePicker" Grid.Column="1" Style="{StaticResource DevicePicker}" Margin="12,0,0,0"
                      SelectionChanged="OnMicrophonePicked" DropDownOpened="OnPickerOpened" />
        </Grid>
        <views:LevelMeter x:Name="MicrophoneMeter" Height="6" Margin="0,12,0,8" />
        <TextBlock x:Name="MicrophoneStatus" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
        <StackPanel x:Name="MicrophoneHint" Orientation="Horizontal" Visibility="Collapsed">
            <TextBlock x:Name="MicrophoneHintText" FontSize="12" Foreground="{DynamicResource TextBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
            <Button Content="Switch" Style="{StaticResource LinkButton}" FontSize="12" Margin="4,0,0,0"
                    Foreground="{DynamicResource AccentTextBrush}"
                    Click="OnMicrophoneHintSwitch" />
            <Button Content="Not now" Style="{StaticResource LinkButton}" FontSize="12" Click="OnMicrophoneHintDismiss" />
        </StackPanel>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Computer audio (the other people on the call)" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <ComboBox x:Name="ComputerPicker" Grid.Column="1" Style="{StaticResource DevicePicker}" Margin="12,0,0,0"
                      SelectionChanged="OnComputerPicked" DropDownOpened="OnPickerOpened" />
        </Grid>
        <views:LevelMeter x:Name="ComputerMeter" Height="6" Margin="0,12,0,8" />
        <TextBlock x:Name="ComputerStatus" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
        <StackPanel x:Name="ComputerHint" Orientation="Horizontal" Visibility="Collapsed">
            <TextBlock x:Name="ComputerHintText" FontSize="12" Foreground="{DynamicResource TextBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
            <Button Content="Switch" Style="{StaticResource LinkButton}" FontSize="12" Margin="4,0,0,0"
                    Foreground="{DynamicResource AccentTextBrush}"
                    Click="OnComputerHintSwitch" />
            <Button Content="Not now" Style="{StaticResource LinkButton}" FontSize="12" Click="OnComputerHintDismiss" />
        </StackPanel>
    </StackPanel>
</UserControl>
