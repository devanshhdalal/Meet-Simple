<UserControl x:Class="MeetSimple.Views.FlowStepStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="ModeText" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentTextBrush}" />
        <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource MutedBrush}" />
        <TextBlock x:Name="StepText" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
    </StackPanel>
</UserControl>
