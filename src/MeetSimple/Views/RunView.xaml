<UserControl x:Class="MeetSimple.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MeetSimple.Views">
    <Grid Margin="32,22,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:FlowStepStrip x:Name="StepStrip" Grid.Row="0" />
        <TextBlock Grid.Row="1" Text="Working on it" Style="{StaticResource DisplayTitle}" FontSize="24"
                   Margin="0,10,0,0" />
        <TextBlock Grid.Row="2" x:Name="SubtitleText" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <ProgressBar x:Name="OverallProgress" Maximum="100" Height="6" />
            <TextBlock x:Name="OverallLabel" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                       Margin="0,6,0,0" Text="Getting ready…" />
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Margin="0,16,0,0" Padding="22,10"
                VerticalAlignment="Top">
            <StackPanel x:Name="StepsPanel" />
        </Border>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                           Text="You can leave this running. Longer recordings take a while." />
                <TextBlock x:Name="ElapsedText" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel x:Name="ButtonBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource QuietButton}" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
