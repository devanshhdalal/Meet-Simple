<UserControl x:Class="MeetSimple.Views.ActivityIsland"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="False">
    <!-- A canvas without a background lets clicks pass through everywhere except the pill itself. -->
    <Canvas x:Name="Stage">
        <Border x:Name="Shell" Background="{DynamicResource IslandBrush}" BorderBrush="{DynamicResource IslandLineBrush}"
                BorderThickness="1" Cursor="Hand" Focusable="True" FocusVisualStyle="{x:Null}"
                AutomationProperties.Name="Show the running job">
            <Border.Effect>
                <DropShadowEffect x:Name="ShellShadow" BlurRadius="24" ShadowDepth="5" Direction="270" Color="Black" Opacity="0.34" />
            </Border.Effect>
            <Grid x:Name="ShellContent">
                <Grid x:Name="CompactContent" Margin="15,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Live indicator: a breathing dot while working, a symbol when done or stopped -->
                    <Grid Width="22" Height="22" VerticalAlignment="Center">
                        <Ellipse x:Name="PulseHalo" Width="22" Height="22" Fill="{DynamicResource AccentBrush}" Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="HaloScale" ScaleX="0.5" ScaleY="0.5" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="PulseDot" Width="9" Height="9" Fill="{DynamicResource AccentBrush}" />
                        <TextBlock x:Name="StateGlyph" FontFamily="Segoe MDL2 Assets" FontSize="14" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,10,0">
                        <TextBlock x:Name="TitleText" Foreground="{DynamicResource IslandTextBrush}" FontSize="13"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailText" Foreground="{DynamicResource IslandMutedBrush}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" Height="0" Opacity="0" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Progress ring with the percentage inside -->
                    <Grid Grid.Column="2" Width="30" Height="30" VerticalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource IslandTrackBrush}" StrokeThickness="3" />
                        <Path x:Name="RingArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock x:Name="PercentText" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource IslandTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- The previous screen, shown while it shrinks into the pill -->
                <Image x:Name="SnapshotImage" Stretch="Fill" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Canvas>
</UserControl>
