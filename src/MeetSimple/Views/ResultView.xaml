<UserControl x:Class="MeetSimple.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MeetSimple.Views">
    <Grid Margin="32,22,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <views:FlowStepStrip x:Name="StepStrip" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE73E;" FontSize="22"
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="All done" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                       Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="WarningText" FontSize="13" Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
            <TextBox x:Name="PreviewBox" Style="{StaticResource BareTextBox}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                     Background="Transparent" Padding="16" VerticalScrollBarVisibility="Auto" />
        </Border>

        <WrapPanel Grid.Row="2" x:Name="ButtonPanel" Margin="0,18,0,0" />
    </Grid>
</UserControl>
