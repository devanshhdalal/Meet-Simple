<Window x:Class="MeetSimple.Views.CallPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meet Simple" Width="560" Height="130" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}" FontSize="14">
    <Window.Resources>
        <!-- Buttons drawn for the black pill, the same in light and dark themes -->
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource IslandTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource IslandTrackBrush}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                Background="{DynamicResource IslandBrush}" BorderBrush="{DynamicResource IslandLineBrush}"
                BorderThickness="1" CornerRadius="26" Padding="9,8,8,8" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PillScale" />
                    <TranslateTransform x:Name="PillShift" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Color="Black" Opacity="0.36" />
            </Border.Effect>
            <Grid>
                <!-- A call started: name it and ask -->
                <StackPanel x:Name="AskPanel" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource IslandTrackBrush}">
                        <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource IslandTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="CallNameText" Margin="11,0,20,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandTextBrush}" />
                    <Button x:Name="NotNowButton" Content="Not now" Style="{StaticResource IslandButton}"
                            Margin="0,0,6,0" Click="OnNotNowClick" />
                    <Button x:Name="RecordButton" Content="Record" Style="{StaticResource IslandButton}"
                            Background="{DynamicResource IslandErrorBrush}" Click="OnRecordClick" />
                </StackPanel>

                <!-- Recording: a live dot, the time, and stop -->
                <StackPanel x:Name="RecordingPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Ellipse x:Name="RecordingDot" Width="10" Height="10" Margin="9,0,10,0" VerticalAlignment="Center"
                             Fill="{DynamicResource IslandErrorBrush}" />
                    <TextBlock x:Name="TimerText" MinWidth="54" VerticalAlignment="Center" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource IslandTextBrush}" />
                    <Button x:Name="StopButton" Style="{StaticResource IslandButton}" Margin="10,0,0,0" Padding="13,9"
                            ToolTip="Stop recording" AutomationProperties.Name="Stop recording" Click="OnStopClick">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource IslandTextBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
