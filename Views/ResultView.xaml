<UserControl x:Class="MeetSimple.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="&#x2713;  All done" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
            <TextBlock x:Name="SubtitleText" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
            <TextBlock x:Name="WarningText" FontSize="13" Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
            <TextBox x:Name="PreviewBox" Style="{StaticResource BareTextBox}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                     Background="Transparent" Padding="16" VerticalScrollBarVisibility="Auto" />
        </Border>

        <WrapPanel Grid.Row="3" x:Name="ButtonPanel" Margin="0,18,0,0" />
    </Grid>
</UserControl>
