<UserControl x:Class="MeetSimple.Views.SourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,8,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Button Content="&#x2190;  Back" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                    Click="OnBackClick" />
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" Margin="0,8,0,2" />
            <TextBlock Text="Where is the audio coming from?" FontSize="14"
                       Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,40,0,0">
            <ContentControl Style="{StaticResource CardBorder}" Width="330" Height="260" Margin="10" Cursor="Hand"
                    MouseLeftButtonUp="OnRecordClick">
                <DockPanel LastChildFill="False">
                    <Border DockPanel.Dock="Top" Style="{StaticResource IconBadge}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE720;" FontSize="19"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Text="Record a meeting" FontSize="19" FontWeight="Bold"
                               Margin="0,16,0,6" />
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                               Text="Captures your microphone and the sound from your computer at the same time - perfect for calls. The transcript shows who said what: You or Others." />
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" Text="Audio only, so files stay small." />
                </DockPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource CardBorder}" Width="330" Height="260" Margin="10" Cursor="Hand"
                    MouseLeftButtonUp="OnFileClick">
                <DockPanel LastChildFill="False">
                    <Border DockPanel.Dock="Top" Style="{StaticResource IconBadge}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8E5;" FontSize="19"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Text="Use an existing file" FontSize="19" FontWeight="Bold"
                               Margin="0,16,0,6" />
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                               Text="Pick a video or audio recording you already have - MP4, MOV, MKV, MP3, WAV, M4A and more." />
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" Text="Large files are fine." />
                </DockPanel>
            </ContentControl>
        </WrapPanel>
    </Grid>
</UserControl>
