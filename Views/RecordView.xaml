<UserControl x:Class="MeetSimple.Views.RecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MeetSimple.Views">
    <Grid Margin="32,8,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Button x:Name="BackButton" Content="&#x2190;  Back" Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Left" Click="OnBackClick" />
            <TextBlock Text="Record a meeting" FontSize="24" FontWeight="Bold" Margin="0,8,0,2" />
            <TextBlock x:Name="SubtitleText" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                       Text="Start the recording, then join or continue your call as usual." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="24" Margin="0,24,0,0">
            <views:LevelMetersControl x:Name="Meters" />
        </Border>

        <StackPanel Grid.Row="2" Margin="0,22,0,0" HorizontalAlignment="Center">
            <TextBlock x:Name="TimerText" Text="00:00:00" FontSize="44" FontWeight="Light"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="3" VerticalAlignment="Bottom" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap"
                   Text="Tip: wear headphones so your microphone doesn't also pick up the other people from your speakers. Only record calls when everyone on them agrees." />

        <Button Grid.Row="4" x:Name="RecordButton" Content="Start recording" Style="{StaticResource AccentButton}"
                HorizontalAlignment="Center" Margin="0,18,0,0" MinWidth="240" Click="OnRecordClick" />
    </Grid>
</UserControl>
